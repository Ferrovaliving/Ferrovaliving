# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Site ---
# Canonical URL used for SEO metadata, sitemap and robots.
# On Vercel this auto-falls back to the deployment URL, so it's optional.
NEXT_PUBLIC_SITE_URL=https://ferrovaliving.vercel.app

# --- Admin gate ---
# When set, /admin and /admin/* require this password (HTTP Basic Auth,
# any username). Leave unset locally to keep the studio open.
ADMIN_PASSWORD=change-me

# --- Supabase (optional — enables lead capture + live content) ---
# Until these are set, the enquiry form runs in demo mode and stores nothing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
