# Copy to .env.local for local dev, and set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Site ---
# Canonical URL used for SEO metadata, sitemap and robots.
# On Vercel this auto-falls back to the deployment URL, so it's optional.
NEXT_PUBLIC_SITE_URL=https://ferrovaliving.vercel.app

# --- Admin gate ---
# When set, /admin and /admin/* require this password (HTTP Basic Auth,
# any username). Leave unset locally to keep the studio open.
ADMIN_PASSWORD=change-me

# --- Supabase (optional — enables lead capture + live content) ---
# Until these are set, the enquiry form accepts submissions but stores nothing.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Add this (server-only) plus the content_store table to edit content in
# production from /admin without a redeploy. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Lead notification: email (optional) ---
# When both are set, every enquiry also emails you. Get the key at resend.com.
# On the free tier, LEAD_NOTIFY_EMAIL must be the address you signed up with,
# and LEAD_NOTIFY_FROM stays as the default until you verify your own domain.
RESEND_API_KEY=re_xxxxxxxx
LEAD_NOTIFY_EMAIL=you@example.com
# LEAD_NOTIFY_FROM=Ferrova Living <onboarding@resend.dev>

# --- Lead notification: WhatsApp (optional) ---
# WHATSAPP_TO: your number, country code first, digits only (e.g. 919024807898).
# Simplest sender — CallMeBot (free): save +34 644 51 95 23 to your contacts,
# WhatsApp it "I allow callmebot to send me messages", it replies with your key.
WHATSAPP_TO=919024807898
WHATSAPP_CALLMEBOT_APIKEY=123456
# Or Twilio instead (needs an approved WhatsApp sender):
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
